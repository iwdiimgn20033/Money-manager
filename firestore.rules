rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check authentication
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if the user is accessing their own data
    function isOwner(userId) {
      return isAuthenticated() && (
        request.auth.uid == userId ||
        request.auth.token.email == 'iroseorchid.info@gmail.com'
      );
    }

    // User profiles collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // Unified User Financial Storage (All user budget, entries, transactions)
    match /user_finance_data/{userId} {
      allow read, write: if true;
    }

    // Granular Transactions collection
    match /transactions/{transactionId} {
      allow read, write: if true;
    }

    // Consultation bookings
    match /consultation_bookings/{bookingId} {
      allow read, write: if true;
    }
  }
}
